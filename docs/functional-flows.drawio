        <mxCell id="auto" value="Auto scan&#10;All loaded apps" style="rounded=1;whiteSpace=wrap;html=0;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1150" y="290" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="checks" value="2. Select checks&#10;Permissions, manifest/intents, files, network, libraries" style="rounded=1;whiteSpace=wrap;html=0;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="460" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="run" value="3. Run and monitor&#10;Counters, current app, outcomes and details" style="rounded=1;whiteSpace=wrap;html=0;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="620" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="Finish or&#10;cancel auto scan?" style="rhombus;whiteSpace=wrap;html=0;fontSize=17;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="850" y="780" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cancel" value="Cancel auto scan&#10;Unfinished checks ≠ passed checks&#10;Review partial results" style="rounded=1;whiteSpace=wrap;html=0;fontSize=17;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="980" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="report" value="4. Read report and details&#10;Risk, unavailable data or limitation?&#10;OK ≠ proven security" style="rounded=1;whiteSpace=wrap;html=0;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
