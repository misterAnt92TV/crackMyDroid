          <mxGeometry x="1120" y="1180" width="370" height="100" as="geometry" />
        </mxCell>
        <object id="limits" label="Heuristic checks, not complete scans&#10;Network: permission combinations, not packets&#10;Libraries: review priority, not CVEs&#10;Files: root/storage, not sandbox reading" link="functional-guide.md#en-limits">
          <mxCell style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
