<mxfile host="app.diagrams.net" type="device">
  <diagram id="database-schema" name="Schema SQLDelight">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="schema-title" value="CrackMyDroid — schema SQLDelight (CacheDatabase)" style="text;html=0;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="schema-source" value="Definizione: shared/src/commonMain/sqldelight/com/crackmydroid/database/CacheDatabase.sq&#10;SQLite — 4 tabelle di cache; PK indicate con PK. I tipi INTEGER memorizzano flag booleani come 0/1." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="table-activities" value="activities_cache&#10;────────────────────&#10;PK packageName TEXT&#10;PK activityName TEXT&#10;appLabel TEXT NOT NULL&#10;label TEXT NOT NULL&#10;exported INTEGER NOT NULL DEFAULT 0&#10;permission TEXT NULL&#10;&#10;PK composta: (packageName, activityName)" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="600" height="245" as="geometry" />
        </mxCell>
        <mxCell id="table-permissions" value="permissions_cache&#10;────────────────────&#10;PK packageName TEXT&#10;PK permission TEXT&#10;appLabel TEXT NOT NULL&#10;&#10;PK composta: (packageName, permission)" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="840" y="220" width="600" height="180" as="geometry" />
        </mxCell>
        <mxCell id="table-installed" value="installed_apps_cache&#10;────────────────────&#10;PK packageName TEXT&#10;appLabel TEXT NOT NULL&#10;sourcePath TEXT NOT NULL&#10;debuggable INTEGER NOT NULL DEFAULT 0&#10;allowBackup INTEGER NOT NULL DEFAULT 0&#10;testOnly INTEGER NOT NULL DEFAULT 0&#10;targetSdkVersion INTEGER NULL&#10;minSdkVersion INTEGER NULL" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="450" y="555" width="600" height="250" as="geometry" />
        </mxCell>
        <mxCell id="table-device" value="device_info_cache&#10;────────────────────&#10;PK key TEXT&#10;value TEXT NOT NULL&#10;&#10;Tabella key/value per i campi memorizzati del dispositivo." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rel-activities-installed" value="packageName&#10;(correlazione logica)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;dashed=1;strokeColor=#666666;fontSize=12;endArrow=none;startArrow=none;" edge="1" parent="1" source="table-activities" target="table-installed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-permissions-installed" value="packageName&#10;(correlazione logica)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;dashed=1;strokeColor=#666666;fontSize=12;endArrow=none;startArrow=none;" edge="1" parent="1" source="table-permissions" target="table-installed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="schema-note" value="Relazioni: lo schema non dichiara FOREIGN KEY. Le linee tratteggiate mostrano solo il packageName comune, non vincoli referenziali.&#10;Nota device info: il commento nello .sq descrive una riga JSON; l’implementazione Android usa invece righe key/value (una per campo) tramite setInfoField/getAllInfo. Le query setDeviceInfo/getDeviceInfo non sono il percorso usato dal repository." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1100" y="555" width="340" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
