<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude cache database and snapshot files on Android < 12 -->
    <exclude domain="database" path="CacheDatabase.db" />
    <exclude domain="database" path="CacheDatabase.db-shm" />
    <exclude domain="database" path="CacheDatabase.db-wal" />
    <exclude domain="external" path="scan_snapshots" />
</full-backup-content>
