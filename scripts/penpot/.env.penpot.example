PENPOT_UI_URL=https://design.penpot.app
# Leave empty: this workflow uses Penpot hosted, not a local backend or Docker.
PENPOT_BACKEND_URL=
# Optional: path to the approved corporate CA bundle (never use -k/--insecure).
PENPOT_CA_BUNDLE=
PENPOT_MCP_URL=http://localhost:4401/mcp
PENPOT_MCP_PLUGIN_URL=http://localhost:4400/manifest.json
PENPOT_MCP_PACKAGE_VERSION=stable
